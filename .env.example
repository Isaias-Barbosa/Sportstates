# ── Placares (ESPN) ──────────────────────────────────────────────────────────
# Nenhuma chave necessária para placar e partidas. ESPN é público.

# ── Transferências — Transfermarkt (recomendado) ──────────────────────────────
# Auto-hospede a API do Transfermarkt via Docker e defina a URL aqui.
# Veja: https://github.com/felipeall/transfermarkt-api
# docker compose up -d   (use o docker-compose.yml na raiz do projeto)
TRANSFERMARKT_API_URL=http://localhost:8000

# ── Transferências — API-Football (fallback) ──────────────────────────────────
# Opcional. Usado como fallback quando TRANSFERMARKT_API_URL não está configurada.
# Plano gratuito tem cota diária. Nunca prefixe com VITE_.
# Obtenha em: https://dashboard.api-football.com/
API_FOOTBALL_KEY=

# ── Servidor local ─────────────────────────────────────────────────────────────
PORT=3000
