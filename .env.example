# Placares e detalhes ESPN: não precisam de chave.
# Transfermarkt: o SDK Python integrado é o padrão, inclusive na Vercel.
# Opcional: URL de uma instância própria da REST API v5 (não necessária).
TRANSFERMARKT_API_URL=
# Alternativa selecionável na tela, com IDs próprios do provedor.
API_FOOTBALL_KEY=
PORT=3000
# Local: Python 3.12/3.13 com requirements.txt instalado.
PYTHON=python3
MARKET_PORT=8001
