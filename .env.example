# Placares ESPN: não precisam de chave.
PORT=3000
# Para editar o Jogo do Dia: chave aleatória com no mínimo 32 caracteres.
ADMIN_ACCESS_KEY=
# Armazenamento privado conectado pela Vercel (não expor no frontend).
BLOB_READ_WRITE_TOKEN=
# Neon Postgres (somente no servidor).
DATABASE_URL=
# Login com Neon Auth: usuário autorizado e URL de Auth do projeto.
ADMIN_EMAIL=
NEON_AUTH_BASE_URL=
# Recommended for most uses

# Web Push. Gere as chaves VAPID com npx web-push generate-vapid-keys.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:contato@example.com
# Segredo aleatório com pelo menos 32 caracteres para o monitor HTTP.
CRON_SECRET=
