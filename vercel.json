{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/market",
      "destination": "/api/transfermarkt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/transfermarkt.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,src/**,tests/**,.git/**}"
    }
  }
}
