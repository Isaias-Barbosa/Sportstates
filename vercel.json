{
  "buildCommand": "VERCEL=0 npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/share-image",
      "destination": "/api/share-image"
    },
    {
      "source": "/api/share",
      "destination": "/api/share"
    },
    {
      "source": "/api/market",
      "destination": "/api/transfermarkt"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/",
      "destination": "/api/share?page=/"
    },
    {
      "source": "/:page((?!api/).*)",
      "destination": "/api/share?page=:page"
    }
  ],
  "functions": {
    "api/transfermarkt.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,src/**,tests/**,.git/**}"
    },
    "api/share.mjs": {
      "includeFiles": "dist/index.html",
      "maxDuration": 30
    },
    "api/share-image.mjs": {
      "maxDuration": 30
    }
  }
}
