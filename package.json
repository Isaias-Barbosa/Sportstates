{
  "name": "sportstates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build && node scripts/sync-premier-league.mjs && node scripts/sync-league-profiles.mjs && node scripts/sync-mls-profiles.mjs && node scripts/sync-basketball-profiles.mjs && node scripts/sync-nfl-profiles.mjs && node scripts/sync-brazil-profiles.mjs && node scripts/sync-mlb-profiles.mjs && node scripts/sync-nhl-profiles.mjs && node scripts/sync-volleyball-profiles.mjs && node scripts/sync-saudi-profiles.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "format": "prettier --write src server api tests README.md docs package.json tsconfig.json vercel.json",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-teams.mjs",
    "db:premier-league": "node --env-file-if-exists=.env.local scripts/sync-premier-league.mjs --apply",
    "db:league-profiles": "node --env-file-if-exists=.env.local scripts/sync-league-profiles.mjs --apply",
    "db:mls": "node --env-file-if-exists=.env.local scripts/sync-mls-profiles.mjs --apply",
    "db:basketball": "node --env-file-if-exists=.env.local scripts/sync-basketball-profiles.mjs --apply",
    "db:nfl": "node --env-file-if-exists=.env.local scripts/sync-nfl-profiles.mjs --apply",
    "db:brazil": "node --env-file-if-exists=.env.local scripts/sync-brazil-profiles.mjs --apply",
    "db:mlb": "node --env-file-if-exists=.env.local scripts/sync-mlb-profiles.mjs --apply",
    "db:nhl": "node --env-file-if-exists=.env.local scripts/sync-nhl-profiles.mjs --apply",
    "db:volleyball": "node --env-file-if-exists=.env.local scripts/sync-volleyball-profiles.mjs --apply",
    "db:saudi": "node --env-file-if-exists=.env.local scripts/sync-saudi-profiles.mjs --apply"
  },
  "dependencies": {
    "@neondatabase/neon-js": "^0.9.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.4",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
